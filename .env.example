# GEMINI_API_KEY: Required for Gemini AI API calls (if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical deployment URL (e.g. https://abmgloballtd.com)
APP_URL="http://localhost:3000"

# SUPABASE: PostgreSQL database & Storage bucket (server-side only — never prefix with NEXT_PUBLIC_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN AUTH: Secret key used to sign admin session cookies/tokens (32+ random bytes hex)
ADMIN_SESSION_SECRET=""
# Optional emergency admin password override (if set, overrides the stored DB password hash)
ADMIN_PASSWORD_OVERRIDE=""

# TRANSACTIONAL EMAIL (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ABM Global Ltd <bookings@abmgloballtd.com>"
COMPANY_NOTIFICATION_EMAIL="info@abmgloballtd.com"

# SECURITY: Comma-separated allowed origins for strict CSRF/CORS checks in production
ALLOWED_ORIGINS=""
